{
  "name": "squaberry",
  "version": "1.0.0",
  "private": true,
  "description": "Squaberry website and enquiry admin, built with Next.js.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-3090}",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs",
    "db:portfolio": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-portfolio.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "logo:build": "node scripts/build-logo.mjs",
    "media:upload": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/upload-media.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "lenis": "^1.3.28",
    "lucide-react": "1.71.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "nodemailer": "10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "0.35.5",
    "typescript": "^5"
  }
}
