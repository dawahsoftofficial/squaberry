# Copy to .env.local (development) or set in Ploi's environment (production). Never commit real values.

# DigitalOcean managed MySQL
DB_HOST=your-db-host.db.ondigitalocean.com
DB_PORT=25060
DB_USER=squaberry
DB_PASSWORD=
DB_NAME=squaberry
# TLS is always on. To also verify the server certificate, download the CA certificate from the
# DigitalOcean database page and set its path here (recommended in production).
DB_CA_CERT_PATH=

# Admin panel (/admin). Use a long random password and a separate random secret of 32+ characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Enquiry emails: each new enquiry is emailed to MAIL_TO (replies go to the visitor).
# Zoho Mail for a custom domain uses smtppro.zoho.com on 465 (SSL). If the mailbox has two-factor
# sign-in, use an app-specific password. Wrap the password in single quotes if it contains # or spaces,
# and keep MAIL_FROM in double quotes (Ploi rejects unquoted values with spaces).
# Leave SMTP_HOST empty to turn emails off (enquiries are still saved and shown in /admin).
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=hello@squaberry.co.uk
SMTP_PASSWORD=
MAIL_FROM="Squaberry website <hello@squaberry.co.uk>"
MAIL_TO=hello@squaberry.co.uk
